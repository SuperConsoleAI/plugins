## Multiple MCPs Example (Supabase)

```json
{
  "id": "supabase",
  "name": "Supabase",
  "version": "1.0.0",
  "description": "Full Supabase access — database, edge functions, storage, management",
  "author": "SuperConsole",
  "icon": "⚡",
  "category": "developer",
  "scope": "project",

  "skills": [
    "https://github.com/SuperConsoleAI/plugins/tree/main/supabase/skills/supabase-query",
    "https://github.com/SuperConsoleAI/plugins/tree/main/supabase/skills/supabase-edge-functions"
  ],

  "commands": [
    "https://github.com/SuperConsoleAI/plugins/blob/main/supabase/commands/query-table.md",
    "https://github.com/SuperConsoleAI/plugins/blob/main/supabase/commands/create-migration.md",
    "https://github.com/SuperConsoleAI/plugins/blob/main/supabase/commands/deploy-function.md"
  ],

  "agents": [],
  "rules": [],
  "hooks": [],

  "mcp": [
    {
      "id": "supabase",
      "name": "Supabase MCP",
      "type": "http",
      "url": "https://mcp.supabase.com/mcp"
    },
    {
      "id": "supabase-management",
      "name": "Supabase Management MCP",
      "type": "stdio",
      "command": "npx",
      "args": ["@supabase/mcp-server-supabase@latest"],
      "env": {
        "SUPABASE_ACCESS_TOKEN": ""
      }
    }
  ],

  "connectors": [
    {
      "id": "supabase",
      "required": true
    }
  ]
}
```

